// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/JuliaLang/devcontainer-templates/tree/main/src/julia
{
	"name": "Julia",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/base:ubuntu",

	// Features to add to the dev container. More info: https://containers.dev/features.
	"features": {
		// A Feature to install Julia via juliaup. More info: https://github.com/JuliaLang/devcontainer-features/tree/main/src/julia.
		"ghcr.io/julialang/devcontainer-features/julia:1": {
			"channel": "1.10.5" //Julia version
			// "channel": "1.10.0" //Julia version
		}
	},

	"postCreateCommand": "julia -e 'using Pkg; Pkg.add(\"IJulia\"); using IJulia; IJulia.installkernel(\"Julia 1.10.5\", \"--project=@.\")' && julia --project=. -e 'using Pkg; Pkg.instantiate(); Pkg.precompile()'",

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"extensions": [
				"julialang.language-julia",
				"tamasfe.even-better-toml",
				"ms-toolsai.jupyter"
			],
			"settings": {
				"julia.environmentPath": "${workspaceFolder}",
				"julia.executablePath": "/home/vscode/.juliaup/bin/julia"
			}
		}
	}

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
